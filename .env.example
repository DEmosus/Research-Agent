# Copy this file to .env and fill in your own values.

# --- Required ---
# OpenAI API key: https://platform.openai.com/api-keys
# Used for both the GPT-4o oracle and the text-embedding-3-small encoder.
OPENAI_API_KEY=sk-...

# Pinecone API key: https://app.pinecone.io
PINECONE_API_KEY=pcsk-...

# SerpAPI key: https://serpapi.com
SERPAPI_KEY=...

# --- Optional (sensible defaults are used if omitted) ---

# --- LLM / embeddings ---
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_CHAT_TEMPERATURE=0
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Pinecone index ---
PINECONE_INDEX_NAME=langgraph-research-agent
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

# --- SerpAPI search ---
SERPAPI_ENGINE=google
SERPAPI_NUM_RESULTS=5

# --- RAG retrieval ---
RAG_TOP_K=5
RAG_FILTERED_TOP_K=6

# --- Agent loop safety cap ---
MAX_AGENT_ITERATIONS=10

# --- Ingestion pipeline defaults (all overridable via CLI flags too) ---
ARXIV_SEARCH_QUERY=cat:cs.AI
ARXIV_MAX_RESULTS=20
CHUNK_SIZE=512
CHUNK_OVERLAP=64
EMBED_BATCH_SIZE=64

# --- Filesystem ---
DATA_DIR=data
OUTPUT_DIR=outputs
